# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Shared
LEDGER_PATH=data_cache/ledger.duckdb
DATA_CACHE_DIR=data_cache

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html). Optional: the
# puller falls back to the public fredgraph CSV endpoint without a key.
FRED_API_KEY=

# Weather paper job guard. The live job refuses to run unless this is exactly 1.
PAPER=0
WEATHER_LEDGER_PATH=ledger/weather.duckdb

# Kalshi. Read-only market data needs no key. No order-placing code exists in
# this repo and none may be added (see CLAUDE.md hard rule 2).
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Alpaca PAPER account only. The paper URL is asserted in code.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# NWS asks for a contact in the User-Agent header.
NWS_USER_AGENT=side-projects (your-email@example.com)

# Notion REST fallback for weekly reports (MCP is preferred when available).
NOTION_API_KEY=
NOTION_PAGE_INVESTING=
NOTION_PAGE_PREDICTION=
NOTION_PAGE_FORECASTING=
NOTION_PAGE_NANOFAB_SAAS=
NOTION_PAGE_MATERIALS=
NOTION_PAGE_LEARNING=
NOTION_PAGE_AUDIT=

# Stripe TEST mode only.
STRIPE_TEST_SECRET_KEY=
